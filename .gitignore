# ============================================
# Smart Energy Monitor - .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Python environment files
.env
.env.local
.env.production

# ---------- Node.js / Frontend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- AI / ML ----------
ai/models/*.joblib
ai/models/*.pkl
ai/models/*.h5
ai/data/*.csv

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- OS Files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Logs ----------
*.log
logs/

# ---------- Cisco Packet Tracer ----------
# Include .pkt files (they are project deliverables)
# But ignore backup files
*.pkt.backup

# ---------- Coverage / Testing ----------
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.tox/

# ---------- Misc ----------
*.bak
*.tmp
*.temp
